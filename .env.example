# --- Database (Vercel Postgres / Neon) ---
# Vercel'de Storage > Postgres ekleyince otomatik doldurulur.
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# --- Session ---
# En az 32 karakter rastgele bir string.
# Üretmek için: openssl rand -base64 48
SESSION_PASSWORD="change-me-to-a-long-random-32-plus-char-string"

# --- Shopier ---
# Shopier panelinden alınır. Boş bırakırsanız sipariş kaydolur ama
# ödeme sayfasına yönlendirme yapılmaz.
SHOPIER_API_KEY=""
SHOPIER_API_SECRET=""
SHOPIER_WEBSITE_INDEX=""

# --- Vercel Blob (görsel yükleme) ---
# Vercel'de Storage > Blob ekleyince otomatik doldurulur.
# Lokalde yoksa dosyalar public/products/ klasörüne kaydedilir.
BLOB_READ_WRITE_TOKEN=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://izmirnaturelcicek.com"
