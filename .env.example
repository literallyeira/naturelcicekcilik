# --- Database (Vercel Postgres / Neon) ---
# Vercel'de Storage > Postgres ekleyince otomatik doldurulur.
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# --- Session ---
# En az 32 karakter rastgele bir string.
# Üretmek için: openssl rand -base64 48
SESSION_PASSWORD="change-me-to-a-long-random-32-plus-char-string"

# --- Shopier ---
# Shopier panelinden alınır. Boş bırakırsanız sipariş kaydolur ama
# ödeme sayfasına yönlendirme yapılmaz.
SHOPIER_API_KEY=""
SHOPIER_API_SECRET=""
SHOPIER_WEBSITE_INDEX=""

# --- Yeni sipariş bildirimi ---
# Doldurulan kanala her yeni siparişte mesaj gider (havale: sipariş anında,
# kart: ödeme başarılı olunca). İkisi de boşsa bildirim gönderilmez.
# Telegram: @BotFather → /newbot ile token al; bota bir mesaj at, sonra
# https://api.telegram.org/bot<TOKEN>/getUpdates adresinden chat id'yi bul.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# WhatsApp (CallMeBot): callmebot.com/blog/free-api-whatsapp-messages
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""

# --- Vercel Blob (görsel yükleme) ---
# Vercel'de Storage > Blob ekleyince otomatik doldurulur.
# Lokalde yoksa dosyalar public/products/ klasörüne kaydedilir.
BLOB_READ_WRITE_TOKEN=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://izmirnaturelcicek.com"
